# ==============================================================================
# RAJPRIYA NOTEBOOK - SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================

# Meta WhatsApp Cloud API Credentials
# Retrieve your Access Token and Phone Number ID from Meta for Developers:
# https://developers.facebook.com/apps/ -> WhatsApp -> API Setup
WHATSAPP_ENABLED=true
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_CLOUD_API_PERMANENT_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_GRAPH_API_VERSION=v20.0

# WhatsApp Webhook Verification Token (set this in Meta Webhooks dashboard)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=rajpriya_wa_secure_webhook_token_2026

# Document Template Name (Used when sending outside 24-hr customer care window)
WHATSAPP_TEMPLATE_NAME=invoice_delivery

# Automatically dispatch invoice PDF upon final admin approval (true/false)
WHATSAPP_AUTO_SEND=true
